{
  "name": "dsh-plugin-background-image",
  "version": "1.1.4",
  "description": "DeepSeek Harness 界面背景图片插件：网络/本地图片与预设渐变背景，支持图片不透明度、沉浸式全屏/仅对话区域、毛玻璃模糊与分区不透明度调节。",
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "background",
    "background-image",
    "theme",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Voyage-He/dsh-plugin-background-image.git"
  },
  "bugs": {
    "url": "https://github.com/Voyage-He/dsh-plugin-background-image/issues"
  },
  "homepage": "https://github.com/Voyage-He/dsh-plugin-background-image#readme",
  "type": "module",
  "main": "./lib/index.js",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "lib",
    "patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
